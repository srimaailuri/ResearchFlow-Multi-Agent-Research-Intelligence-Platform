# Google Gemini API key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Optional: Tavily for web search (https://tavily.com). If unset, DuckDuckGo is used.
# TAVILY_API_KEY=

# Optional overrides
# MODEL_NAME=gemini-3.8-flash
# EVALUATE_MODEL_NAME=gemini-3-flash-preview
# LLM_MAX_RETRIES=4
# LLM_RETRY_MIN_WAIT_SECONDS=2
# EMBEDDING_MODEL=gemini-embedding-001
# RAG_DOCUMENTS_DIR=Data/test_documents
# CHROMA_PERSIST_DIR=.chroma
# RETRIEVAL_TOP_K=3
# RETRIEVAL_RAG_CANDIDATE_K=8
# RAG_PREFERRED_DOCUMENT_BOOST=0.2
# MAX_EVIDENCE_PER_TASK=5
# MAX_TOTAL_EVIDENCE=15
# CHECKPOINTER_MODE=memory
# CHECKPOINT_SQLITE_PATH=.checkpoints/researchflow.db
# LOG_LEVEL=INFO
# LOG_JSON=true
# BENCHMARK_TOPIC_PASS_RECALL=0.5
# BENCHMARK_ANSWER_PASS_SIMILARITY=0.35
# MAX_EVALUATE_WORKERS=4
# MAX_CONCURRENT_RESEARCH_JOBS=2
